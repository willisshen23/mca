# Production example for serving the frontend at http://159.1.56.109:8080

HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://132.1.81.194:8080

# ============ 系统配置 ============
DB_PATH=data/checkpoints.db
BUSINESS_DATABASE_URL=sqlite:///data/skills.db
# 生产建议使用 MySQL（对话记录等业务表将建到该库）：
# DATABASE_HOST 非空时连接 MySQL；留空时使用 SQLite：
DATABASE_HOST=132.1.91.41
DATABASE_PORT=8888
DATABASE_USERNAME=njcb_coap
DATABASE_PASSWORD="Njcb_coap@123"
DATABASE_NAME=coap
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
LOG_LEVEL=INFO
# 日志持久化（写入按天轮转的带日期文件，默认开启）
LOG_TO_FILE=true
LOG_DIR=data/logs
# 日志基名，实际文件会带上日期，如 app-2026-06-25.log
LOG_FILE=app.log
# 按天轮转后保留的日志文件数量（天数）
LOG_FILE_BACKUP_COUNT=30

# ============ 全局默认 LLM 配置（所有 Agent 的 fallback）============
# 支持任意兼容 OpenAI API 范式的大模型
# 请填入内网大模型的实际信息
LLM_API_KEY=sk-6RpLczHaSDpjqsNUcO3EPg
LLM_BASE_URL=http://132.1.95.34:4000/v1
LLM_MODEL=DeepSeek-V4
LLM_MAX_TOKENS=262144
LLM_OUTPUT_TOKEN_RESERVE=16384

# ============ LLM API Key 密文（可选，推荐生产使用）============
# 支持把 *_LLM_API_KEY 以密文形式保存在本文件（enc:v1: 前缀，AES-256-GCM），
# 明文只在进程内存出现；主密钥与密文物理分离（不进本文件、不进 git）。
# 生成主密钥并加密：
#   python scripts/env_secret.py init
#   python scripts/env_secret.py encrypt --env backend/.env
# 主密钥注入方式（二选一，进程环境变量优先）：
#   1) 环境变量 LLM_MASTER_KEY=hex64 字符
#   2) 密钥文件 LLM_MASTER_KEY_FILE=/path/master.key（默认 backend/data/secrets/master.key）
# 示例（enc:v1: 开头即为密文，明文写法继续兼容）：
# LLM_API_KEY=enc:v1:xxxx
# ==============================================================

# ============ 按 Agent 覆盖配置（生产环境建议全部明确配置）============
# 主管 Agent
# SUPERVISOR_LLM_API_KEY=
# SUPERVISOR_LLM_BASE_URL=
# SUPERVISOR_LLM_MODEL=
# SUPERVISOR_LLM_MAX_TOKENS=262144

# 数据分析 Agent
# DATA_ANALYSIS_LLM_API_KEY=
# DATA_ANALYSIS_LLM_BASE_URL=
# DATA_ANALYSIS_LLM_MODEL=
# DATA_ANALYSIS_LLM_MAX_TOKENS=262144

# 报告生成 Agent
# REPORT_GENERATION_LLM_API_KEY=
# REPORT_GENERATION_LLM_BASE_URL=
# REPORT_GENERATION_LLM_MODEL=
# REPORT_GENERATION_LLM_MAX_TOKENS=262144

# 报告校验 Agent
# REPORT_VALIDATION_LLM_API_KEY=
# REPORT_VALIDATION_LLM_BASE_URL=
# REPORT_VALIDATION_LLM_MODEL=
# REPORT_VALIDATION_LLM_MAX_TOKENS=262144

# 汇总 Agent
# FINALIZE_LLM_API_KEY=
# FINALIZE_LLM_BASE_URL=
# FINALIZE_LLM_MODEL=
# FINALIZE_LLM_MAX_TOKENS=262144
# LLM 单次请求超时时间（秒），需小于 nginx proxy_read_timeout(1200s)
LLM_TIMEOUT_SECONDS=1200

# ============ agent_v2（deepagents 自主智能体）============
# v2 主推理模型（首轮/复杂请求）。要求：端点必须支持 tool calling（function calling）。
# 不配置则回落上面的全局 LLM_* 三件套；如需单独指定，取消注释并填写：
# AGENT_V2_MAIN_LLM_API_KEY=
# AGENT_V2_MAIN_LLM_BASE_URL=
# AGENT_V2_MAIN_LLM_MODEL=
# AGENT_V2_MAIN_LLM_MAX_TOKENS=262144

# v2 轻量模型（短确认/闲聊，可选）
# AGENT_V2_CHEAP_LLM_API_KEY=
# AGENT_V2_CHEAP_LLM_BASE_URL=
# AGENT_V2_CHEAP_LLM_MODEL=
# AGENT_V2_CHEAP_LLM_MAX_TOKENS=262144

# v2 降级备选模型（主模型调用异常时兜底，可选）
# 注意：需配置为与主模型不同的模型才有真正的降级意义，
# 否则回落到全局 LLM_* 时等同于用同一模型重试一次。
# AGENT_V2_FALLBACK_LLM_API_KEY=
# AGENT_V2_FALLBACK_LLM_BASE_URL=
# AGENT_V2_FALLBACK_LLM_MODEL=
# AGENT_V2_FALLBACK_LLM_MAX_TOKENS=262144

# agent_v2 历史摘要触发阈值（tokens，预留，当前暂未生效）
# AGENT_V2_SUMMARY_MAX_TOKENS=120000
# LangGraph 单次运行最大步数，用于防止 Agent 流程失控循环
AGENT_V2_RECURSION_LIMIT=200

# ============ 银行营销外部 API 配置 ============
# 每个接口都单独配置完整 URL（含协议、主机、端口、路径）
# 可选：如外部接口需要 Bearer Token
BANK_MARKETING_API_TOKEN=
BANK_MARKETING_API_TIMEOUT_SECONDS=600

# 活动列表 API：根据 LLM 生成的 keyword/activity_type/start_date/end_date 查询活动
BANK_MARKETING_ACTIVITY_LIST_URL=http://web.coap.njcb:8125/prod-api/resource/activity/getActInfoListNoauth
BANK_MARKETING_ACTIVITY_LIST_METHOD=POST
# 活动查询来源系统：P10 运营分析平台，S05 营销大脑
BANK_MARKETING_ACTIVITY_SRC_SYS_NO=P10

# 模板列表 API：获取全部或按 scene 过滤的模板列表
BANK_MARKETING_TEMPLATE_LIST_URL=http://web.coap.njcb:8125/prod-api/activity-ana/newReportNoauth/pageNoauth
BANK_MARKETING_TEMPLATE_LIST_METHOD=POST

# 组件数值 API：根据 template_id/activity_ids/component_ids/metrics 获取业务指标
BANK_MARKETING_COMPONENT_VALUES_URL=http://web.coap.njcb:8125/prod-api/activity-ana/newReportNoauth/queryAnaDetailDataNoauth
BANK_MARKETING_DATA_TEMPLATE_MATCH_TOP_N=1

# 外呼活动查询 API：单活动选中后优先查询真实业务数据，查不到再走模板组件兜底
# URL 中可使用 {trade_code} 占位符，会按交易码逐一替换
BANK_MARKETING_OUTBOUND_ACTIVITY_DATA_URL=http://132.1.92.23:8911/dataservice/query/{trade_code}
BANK_MARKETING_OUTBOUND_ACTIVITY_DATA_METHOD=POST
BANK_MARKETING_OUTBOUND_ACTIVITY_TRADE_CODES=EDW_RTL_MED_ASSET_CONVERSION,EDW_RTL_MED_PRODUCT_TRANSACTION,EDW_RTL_MED_ACTIVITY_BASE_INFO,EDW_RTL_MED_OUTBOUND_CALL_EXECUTION,EDW_RTL_MED_SOURCE_OF_PRODUCT_VALIDCALL
# 默认渠道编码（科管系统简称编码），请求未传 channel 时回退使用
BANK_MARKETING_DEFAULT_CHANNEL=AILMIS
# 外呼活动接口 identity 默认值（请求未传时使用）
BANK_MARKETING_DEFAULT_USER_ID=1011273
BANK_MARKETING_DEFAULT_ORG_NO=001


