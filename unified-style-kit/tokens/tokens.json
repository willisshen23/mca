{
  "$comment": "FAB 统一设计令牌 —— 与 design-tokens.css 等价的机器可读版本。供 tailwind.config.js / JS 图表配色引用，改动请两边同步。",
  "brand": {
    "blue": "#0081E4",
    "cyan": "#02A6C9",
    "deep": "#1E57AE"
  },
  "color": {
    "primary": {
      "DEFAULT": "#2B6EDD",
      "hover": "#1F5BC4",
      "active": "#17499F",
      "weak": "#EAF1FD",
      "weaker": "#F5F9FE",
      "border": "#BFD5F6"
    },
    "violet": { "DEFAULT": "#8D9DF8", "weak": "#EFF0FE" },
    "success": { "DEFAULT": "#12A150", "weak": "#E8F7EE", "border": "#A8E0C2" },
    "warning": { "DEFAULT": "#E08700", "weak": "#FDF3E2", "border": "#F2D19A" },
    "danger":  { "DEFAULT": "#D92B2B", "hover": "#B81F1F", "weak": "#FDECEC", "border": "#F2B5B5" },
    "info":    { "DEFAULT": "#2B6EDD", "weak": "#EAF1FD" }
  },
  "text": {
    "1": "#191919",
    "2": "#4A4F58",
    "3": "#727472",
    "4": "#A3A8AF",
    "invert": "#FFFFFF"
  },
  "bg": {
    "page": "#FFFFFF",
    "subtle": "#F6F9FD",
    "sunken": "#EDF3FB",
    "elevated": "#FFFFFF",
    "mask": "rgba(16, 32, 60, 0.45)"
  },
  "border": {
    "weak": "#EEF3FA",
    "base": "#E5EFF9",
    "strong": "#D6E1F3",
    "hover": "#BFD5F6"
  },
  "gradient": {
    "hero": "linear-gradient(180deg, #A4C7F0 0%, #C4DBF8 46%, #F2F6FB 88%, #FFFFFF 100%)",
    "heroViolet": "radial-gradient(120% 140% at 88% 8%, rgba(141,157,248,.55) 0%, rgba(141,157,248,0) 58%)",
    "brand": "linear-gradient(135deg, #0081E4 0%, #2B6EDD 55%, #8D9DF8 100%)",
    "brandSoft": "linear-gradient(135deg, #EAF1FD 0%, #EFF0FE 100%)"
  },
  "fontSize": {
    "2xs":     ["11px", { "lineHeight": "1.45" }],
    "xs":      ["12px", { "lineHeight": "1.5"  }],
    "sm":      ["13px", { "lineHeight": "1.55" }],
    "body":    ["14px", { "lineHeight": "1.6"  }],
    "h4":      ["16px", { "lineHeight": "1.5"  }],
    "h3":      ["18px", { "lineHeight": "1.45" }],
    "h2":      ["22px", { "lineHeight": "1.4"  }],
    "h1":      ["28px", { "lineHeight": "1.35" }],
    "display": ["40px", { "lineHeight": "1.25" }],
    "metric":  ["32px", { "lineHeight": "1.2"  }]
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },
  "borderRadius": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "2xl": "28px",
    "pill": "999px"
  },
  "boxShadow": {
    "xs": "0 1px 2px rgba(30, 58, 110, .05)",
    "sm": "0 2px 8px rgba(30, 58, 110, .06)",
    "md": "0 6px 20px rgba(30, 58, 110, .08)",
    "lg": "0 14px 40px rgba(30, 58, 110, .12)",
    "focus": "0 0 0 3px rgba(43, 110, 221, .16)"
  },
  "controlHeight": { "sm": "28px", "md": "34px", "lg": "42px" },
  "layout": {
    "$comment": "沿用各项目现有排版的记录值，不是统一要求；统一的只有视觉风格。",
    "topbarH": "64px",
    "topbarHCompact": "48px",
    "iconbarW": "52px",
    "sidebarW": "220px",
    "contentMax": "1920px",
    "gutter": "24px"
  },
  "chart": {
    "$comment": "图表分类色序：前 3 位覆盖大多数场景，已按明度错开，灰度打印仍可区分。",
    "categorical": ["#2B6EDD", "#02A6C9", "#8D9DF8", "#12A150", "#E08700", "#6E7CA8", "#4FA8E8", "#C9A227"],
    "sequentialBlue": ["#EAF1FD", "#C9DCFA", "#A3C3F3", "#729FE8", "#4A80DE", "#2B6EDD", "#1F5BC4", "#17499F"],
    "grid": "#EEF3FA",
    "axis": "#727472"
  }
}
